{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.misu.r6md",
  "name": "R6MD",
  "version": "1.4.4",
  "description": "Rainbow Six Siege match tracking over replay files: scores, operators, rounds, kill feed and session stats.",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/R6Md.dll",
      "runtime": { "kind": "FrameworkDependent", "dotnetVersion": "10.0" }
    }
  },
  "publisher": {
    "name": "Misu"
  },
  "license": "MIT",
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": true,
    "services": ["Muse Spark via OpenCode"]
  },
  "permissions": ["host:messaging"],
  "compatibility": {
    "macroDeck": ">=3.0.0-beta.13"
  },
  "repository": "https://github.com/misike12/MacroTools",
  "additionalLinks": [
    { "type": "issues", "url": "https://github.com/misike12/MacroTools/issues" }
  ]
}
