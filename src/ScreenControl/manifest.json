{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.misu.screen-control",
  "name": "Screen Control",
  "version": "1.5.0",
  "description": "Control monitors (DDC brightness/input) and windows (focus, minimize, virtual desktops).",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/ScreenControl.dll",
      "runtime": { "kind": "FrameworkDependent", "dotnetVersion": "10.0" }
    }
  },
  "publisher": {
    "name": "Misu"
  },
  "license": "MIT",
  "permissions": ["host:messaging"],
  "compatibility": {
    "macroDeck": ">=3.0.0-beta.12"
  },
  "repository": "https://github.com/misike12/MacroTools",
  "additionalLinks": [
    { "type": "issues", "url": "https://github.com/misike12/MacroTools/issues" }
  ]
}
